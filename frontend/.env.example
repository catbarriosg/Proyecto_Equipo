# Copia este archivo como .env.local para cambiar el origen de los datos.

# true  = usa el backend (docker compose up en la raíz del proyecto). Valor por defecto.
# false = usa la base de datos simulada en localStorage, sin backend.
VITE_USE_API=true

# Dirección del gateway para el proxy de desarrollo de Vite (npm run dev)
# VITE_PROXY_API=http://localhost:8080
